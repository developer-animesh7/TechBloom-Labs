# ==========================================================================
# TechBloom — environment example
# Copy to `.env` and fill in the values that exist. Every value is optional:
# the site runs without them and never claims a message was actually sent.
# ==========================================================================

# Official TechBloom contact address. Left blank on purpose — no email address
# has been supplied, and none is invented in code.
# When set, the contact / proposal / support forms compose a message to it.
VITE_CONTACT_EMAIL=contact@techbloomlabs.com

# Optional public phone number shown in the contact section.
VITE_CONTACT_PHONE=

# Optional form endpoint (any service that accepts a JSON POST).
# When set, forms submit for real and use the live success / error states.
# When empty, forms validate, show the submitting state, then state clearly
# that no delivery backend is connected yet.
VITE_CONTACT_ENDPOINT=

# Public site origin, used for canonical and Open Graph URLs.
VITE_SITE_URL=https://discover-bloom.preview.static.emergentagent.com
